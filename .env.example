# Variáveis do ESCUTA 14. Copie para .env.local e preencha. NUNCA commitar valores.
# Onde achar cada uma: docs/manual-tecnico.md, seção "Variáveis".

# Supabase: Project Settings → API Keys / Data API. A chave secreta só existe no servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (antispam). A Site Key é pública; a Secret Key é segredo.
# No computador de quem programa, use as chaves de teste do manual técnico.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Segredo para embaralhar o IP (antispam) e o protocolo. Gerar uma vez, com 32+ caracteres
# aleatórios, e nunca trocar sem ler o manual (protocolos antigos deixam de ser achados).
SEGREDO_ANONIMATO=

# Segredo da rotina diária da Vercel (fatia 3.2).
CRON_SECRET=

# Período da mostra (não são segredo). Tudo o que chega nesse intervalo nasce como demonstração.
MOSTRA_INICIO=2026-11-10T00:00:00-03:00
MOSTRA_FIM=2026-11-11T00:00:00-03:00
